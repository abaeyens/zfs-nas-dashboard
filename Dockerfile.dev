# Development image — Go toolchain plus the system tools the dashboard
# needs at runtime, plus prettier and Claude Code for in-container dev work.
# Used by:
#   - `make dev`            (long-running dev container via docker-compose.dev.yml)
#   - `make fmt`, `make claude`  (ephemeral)
# Never used in production. The production image is built from `Dockerfile`.

FROM golang:1.26-bookworm

RUN echo "deb http://deb.debian.org/debian bookworm contrib" >> /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        smartmontools \
        zfsutils-linux \
        nodejs \
        npm \
        git \
    && npm install -g prettier @anthropic-ai/claude-code \
    && rm -rf /var/lib/apt/lists/*

# Pre-warm the Go module cache so `go run` / `go test` / `go vet` inside the
# container don't re-download dependencies on first use.
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

# Source tree is bind-mounted at /app by docker-compose.dev.yml (and by
# `make fmt` / `make claude`); the binary is built on demand via `go run`.
WORKDIR /app
CMD ["bash"]
