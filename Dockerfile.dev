# Development image — extends the runtime image with code-formatting tools
# and Claude Code (for sandboxed agent work).
# Not suitable for production: contains nodejs, npm, prettier, and claude-code.
#
# Used automatically when running `docker compose up` locally, via
# docker-compose.override.yml.  Production deployments use the plain
# Dockerfile instead:
#   docker compose -f docker-compose.yml up -d

FROM golang:1.26.1-bookworm

RUN echo "deb http://deb.debian.org/debian bookworm contrib" >> /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends smartmontools zfsutils-linux nodejs npm git \
    && npm install -g prettier @anthropic-ai/claude-code \
    && rm -rf /var/lib/apt/lists/*

# Pre-warm the Go module cache so `go test` / `go vet` inside the container
# (via `make claude`) don't re-download dependencies on every fresh container.
# We do not build the binary here: this image is only used for code-formatting
# and for running Claude Code interactively — the runtime binary comes from
# Dockerfile, built inside the running runtime container via `make build`.
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

# /app is the working directory; the source tree is bind-mounted here.
WORKDIR /app
CMD ["bash"]
